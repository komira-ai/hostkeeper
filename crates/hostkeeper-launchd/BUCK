load("//:buildrules.bzl", "cargo_package")

# What this package reads beyond src/, tests/ and build.rs, which a Buck2 action sees only when
# declared (a unit sees its own src/, tests/ or build.rs alone). A test includes docs/macos.md.
cargo_package(
    path = ".",
    extra_srcs = [
        "src",
        "//:docs/macos.md",
    ],
)
