load("//:buildrules.bzl", "cargo_package")

# The Linux farm compiles out this member's code and tests under cfg(target_os = "macos"); release.yml's job macos-test runs them on a Mac (docs/farm.md).

# What this package reads beyond src/, tests/ and build.rs, which a Buck2 action sees only when
# declared (a unit sees its own src/, tests/ or build.rs alone). A test includes docs/macos.md.
cargo_package(
    path = ".",
    extra_srcs = [
        "src",
        "//:docs/macos.md",
    ],
)

# Read by other members (their extra_srcs); exported by reference, so each stays at its path.
[
    export_file(
        name = path,
        src = path,
        mode = "reference",
        visibility = ["PUBLIC"],
    )
    for path in [
        "tests/fixtures/sysctl-bootsessionuuid.txt",
    ]
]
