load("//:buildrules.bzl", "cargo_package")

cargo_package(path = ".")

# Read by other members (their extra_srcs); exported by reference, so each stays at its path.
[
    export_file(
        name = path,
        src = path,
        mode = "reference",
        visibility = ["PUBLIC"],
    )
    for path in [
        "tests/macos_pkg/support",
        "tests/support",
    ]
]
