# mdm-scep.service: the SCEP server that issues each Mac its MDM identity
# certificate at enrollment. A unit of the mdm package, linked by hostkeeper
# from the package's current version.
#
# Loopback only, and its sockets may talk to loopback only (IPAddressDeny).
# The challenge comes from EnvironmentFile as SCEP_CHALLENGE_PASSWORD, never
# argv. The CA key lives in the depot under the 0700 state directory, without
# a passphrase (a passphrase would have to be on argv or in the same place).
[Unit]
Description=mdm SCEP server (loopback only)
After=network-online.target

[Service]
Type=simple
User=mdm
Group=mdm
Slice=mdm.slice
EnvironmentFile=/etc/mdm/scep.env
ExecStart=/var/lib/hostkeeper/packages/mdm/current/bin/scepserver -http-addr 127.0.0.1:9005 -depot /var/lib/mdm/scep/depot -crtvalid 365 -allowrenew 14
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/mdm/scep
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
