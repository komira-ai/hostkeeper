# Caddyfile of hostkeeper-mdm-proxy, rendered by `hostkeeper-mdm install` into
# /etc/hostkeeper-mdm/Caddyfile. Edit the template in hostkeeper-mdm-core.
#
# TLS only, on the LAN address only, with lego's certificate. Caddy's own ACME,
# its HTTP->HTTPS redirect listener on :80 and its admin API are all off.
{
	admin off
	auto_https off
	persist_config off
	default_bind @TEST_BIND@
	servers {
		protocols h1 h2
	}
}

https://mdm.example.com:443 {
	tls /var/lib/hostkeeper-mdm/lego/certificates/mdm.example.com.crt /var/lib/hostkeeper-mdm/lego/certificates/mdm.example.com.key

	# MDM check-in and command channels (NanoHUB).
	handle /mdm {
		reverse_proxy 127.0.0.1:9004
	}
	handle /checkin {
		reverse_proxy 127.0.0.1:9004
	}
	handle /version {
		reverse_proxy 127.0.0.1:9004
	}

	# Identity certificates at enrollment (the SCEP server).
	handle /scep {
		reverse_proxy 127.0.0.1:9005
	}

	# The enrollment profile: ADE posts to this URL, a person downloads it with
	# GET. Either way the same file, /var/lib/hostkeeper-mdm/www/enroll.mobileconfig.
	handle /enroll {
		method GET
		root * /var/lib/hostkeeper-mdm/www
		rewrite * /enroll.mobileconfig
		header Content-Type application/x-apple-aspen-config
		file_server
	}

	# The hostkeeper pkg, by its digest only: GET /pkg/<sha256>.pkg is the file
	# <sha256>.pkg of /var/lib/hostkeeper-mdm-pkg. Every other name under /pkg is 404, so a
	# directory listing or another file is never served. The Mac checks the digest
	# itself (the manifest of InstallEnterpriseApplication carries it). The matcher's
	# name, @pkg, is a value of the render, as the template syntax needs.
	@pkg path_regexp ^/pkg/[0-9a-f]{64}\.pkg$
	handle @pkg {
		uri strip_prefix /pkg
		root * /var/lib/hostkeeper-mdm-pkg
		file_server
	}

	# Everything else, NanoHUB's /api/ and NanoDEP included, is not served here.
	handle {
		respond 404
	}
}
