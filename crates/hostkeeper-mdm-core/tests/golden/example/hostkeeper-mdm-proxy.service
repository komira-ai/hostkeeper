# hostkeeper-mdm-proxy.service: Caddy as the TLS front of the MDM, rendered by
# `hostkeeper-mdm install`. Edit the template.
#
# Binds the LAN address only (the Caddyfile's default_bind), port 443 through
# CAP_NET_BIND_SERVICE and no other capability, and its sockets talk only to
# loopback and the rack LAN (IPAddressAllow). It routes /mdm, /checkin, /scep,
# /enroll and /version; everything else, NanoHUB's API included, is 404.
# The certificate is lego's (hostkeeper-mdm-cert.service); a renewal restarts this
# unit through hostkeeper-mdm-proxy-reload.path.
[Unit]
Description=hostkeeper-mdm HTTPS proxy (LAN address only)
After=network-online.target hostkeeper-mdm-nanohub.service hostkeeper-mdm-scep.service
Wants=network-online.target

[Service]
Type=simple
User=hostkeeper-mdm
Group=hostkeeper-mdm
Slice=hostkeeper-mdm.slice
Environment=XDG_DATA_HOME=/var/lib/hostkeeper-mdm/caddy XDG_CONFIG_HOME=/var/lib/hostkeeper-mdm/caddy
ExecStart=/opt/hostkeeper-mdm/bin/caddy run --config /etc/hostkeeper-mdm/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ReadWritePaths=/var/lib/hostkeeper-mdm/caddy
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost @TEST_LAN@

[Install]
WantedBy=multi-user.target
