load("//:buildrules.bzl", "cargo_package")

# The Linux farm compiles out this member's code and tests under cfg(target_os = "macos"); release.yml's job macos-test runs them on a Mac (docs/farm.md).

# What this package reads beyond src/, tests/ and build.rs, which a Buck2 action sees only when
# declared (a unit sees its own src/, tests/ or build.rs alone). Tests share the installer's fakes (`#[path]`) and read the packaging, hello's package and the README they are held to.
cargo_package(
    path = ".",
    extra_srcs = [
        "tests/fixtures/maintenance",
        "//:README.md",
        "//:packaging/linux",
        "//crates/hostkeeper-install:tests/macos_pkg/support",
        "//crates/hostkeeper-install:tests/support",
        "//crates/hostkeeper-steps:tests/fixtures/kbf-v0.0.64",
        "//examples/hello:package",
    ],
)
