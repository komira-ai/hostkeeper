{
 "from": "kbf-coordinator/src/http_tests/features.rs::a_bad_announcement_is_dropped_and_the_host_is_answered_as_an_old_agent",
 "services_fixture": "kbf.services.toml",
 "services_text": "[[service]]\nname = \"other\"\n[service.roles.daemon]\nmin_up = 0\n",
 "oidc_services": [
  "kbf",
  "other"
 ],
 "steps": [
  {
   "at_secs": 1000,
   "call": "desired",
   "body": "{\"version\":\"2.0\",\"min_up\":{\"storage\":1,\"frontend\":1}}",
   "expect_status": 200,
   "expect_body": "{\"version\":\"2.0\",\"max_updating\":{\"frontend\":1,\"storage\":1,\"daemon\":2,\"mac-daemon\":2},\"min_up\":{\"storage\":1,\"frontend\":1}}"
  },
  {
   "at_secs": 1000,
   "call": "desired",
   "body": "{\"service\":\"other\",\"version\":\"3.0\",\"min_up\":{\"storage\":0,\"frontend\":0}}",
   "expect_status": 200,
   "expect_body": "{\"version\":\"3.0\",\"max_updating\":{\"frontend\":1,\"storage\":1,\"daemon\":2,\"mac-daemon\":2},\"min_up\":{\"storage\":0,\"frontend\":0}}"
  },
  {
   "at_secs": 2000,
   "call": "heartbeat",
   "host": "d1",
   "role": "daemon",
   "body": "{\"platform\":\"linux-x86_64\",\"version\":\"1.0\",\"health\":\"healthy\",\"agent_features\":[\"Halt-V1\"]}",
   "expect_status": 200,
   "expect_body": "{\"reply\":\"update\",\"version\":\"2.0\"}"
  },
  {
   "at_secs": 2000,
   "call": "heartbeat",
   "host": "d2",
   "role": "daemon",
   "body": "{\"platform\":\"linux-x86_64\",\"version\":\"2.0\",\"health\":\"healthy\",\"agent_features\":[\"Halt-V1\"]}",
   "expect_status": 200,
   "expect_body": "{\"reply\":\"nothing\"}"
  },
  {
   "at_secs": 2000,
   "call": "heartbeat",
   "host": "d2",
   "role": "daemon",
   "body": "{\"platform\":\"linux-x86_64\",\"version\":\"2.0\",\"health\":\"healthy\",\"agent_features\":[\"halt-v1\",\"halt-v1\"]}",
   "expect_status": 200,
   "expect_body": "{\"reply\":\"nothing\"}"
  },
  {
   "at_secs": 2000,
   "call": "heartbeat",
   "host": "d2",
   "role": "daemon",
   "body": "{\"platform\":\"linux-x86_64\",\"version\":\"2.0\",\"health\":\"healthy\",\"agent_features\":[\"a\",\"b\",\"c\",\"d\",\"e\",\"f\",\"g\",\"h\",\"i\"]}",
   "expect_status": 200,
   "expect_body": "{\"reply\":\"nothing\"}"
  },
  {
   "at_secs": 2000,
   "call": "heartbeat",
   "host": "d2",
   "role": "daemon",
   "body": "{\"platform\":\"linux-x86_64\",\"version\":\"2.0\",\"health\":\"healthy\",\"agent_features\":[\"\"]}",
   "expect_status": 200,
   "expect_body": "{\"reply\":\"nothing\"}"
  }
 ]
}
