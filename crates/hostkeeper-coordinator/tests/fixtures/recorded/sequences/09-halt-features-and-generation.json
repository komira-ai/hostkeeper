   "expect_status": 200
  },
  {
   "at_secs": 1100,
   "call": "operator",
   "body": "{\"action\":\"clear_halt\",\"service\":\"kbf\",\"reason\":\"disk replaced\"}",
   "expect_status": 200,
   "expect_contains": [
    "\"by\":\"operator\",\"action\":\"clear_halt\",\"service\":\"kbf\",\"node_id\":\"s1\",\"reason\":\"disk replaced\""
   ]
  },
  {
   "at_secs": 1100,
   "call": "heartbeat",
   "host": "d1",
   "role": "daemon",
   "body": "{\"platform\":\"linux-x86_64\",\"version\":\"2.0\",\"health\":\"healthy\",\"agent_features\":[\"halt-v1\"]}",
   "expect_status": 200,
   "expect_body": "{\"reply\":\"nothing\",\"features\":[\"halt-v1\"],\"halts\":{\"kbf\":1}}"
  },
  {
   "at_secs": 1100,
   "call": "heartbeat",
   "host": "d1",
   "role": "daemon",
   "body": "{\"platform\":\"linux-x86_64\",\"version\":\"2.0\",\"health\":\"healthy\"}",
   "expect_status": 200,
