   "call": "desired",
   "body": "{\"version\":\"2.0\",\"min_up\":{\"storage\":0,\"frontend\":0}}",
   "expect_status": 200,
   "expect_body": "{\"version\":\"2.0\",\"max_updating\":{\"frontend\":1,\"storage\":1,\"daemon\":2,\"mac-daemon\":2},\"min_up\":{\"storage\":0,\"frontend\":0}}"
  },
  {
   "at_secs": 1100,
   "call": "heartbeat",
   "host": "d1",
   "role": "daemon",
   "body": "{\"platform\":\"linux-x86_64\",\"version\":\"2.0\",\"health\":\"healthy\",\"agent_features\":[\"halt-v1\"]}",
   "expect_status": 200,
