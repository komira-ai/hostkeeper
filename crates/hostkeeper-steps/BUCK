load("//:buildrules.bzl", "cargo_package")

# What this package reads beyond src/, tests/ and build.rs, which a Buck2 action sees only when
# declared. The spawn fixture binary lives under tests/bin; a test reads MIGRATION.md.
cargo_package(
    path = ".",
    extra_srcs = [
        "tests/bin",
        "//:MIGRATION.md",
    ],
)

# Read by other members (their extra_srcs); exported by reference, so each stays at its path.
[
    export_file(
        name = path,
        src = path,
        mode = "reference",
        visibility = ["PUBLIC"],
    )
    for path in [
        "tests/fixtures/kbf-v0.0.64",
    ]
]
