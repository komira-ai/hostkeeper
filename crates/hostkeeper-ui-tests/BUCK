load("//:buildrules.bzl", "cargo_package")

# What this package reads beyond src/, tests/ and build.rs, which a Buck2 action sees only when
# declared. The tests run the web app of ui/ and read the protos its client is generated from.
cargo_package(
    path = ".",
    extra_srcs = [
        "vendor.sha256",
        "//crates/hostkeeper-console:src/close.rs",
        "//crates/hostkeeper-proto:proto",
        "//:ui",
    ],
)

# Read by other members (their extra_srcs); exported by reference, so each stays at its path.
[
    export_file(
        name = path,
        src = path,
        mode = "reference",
        visibility = ["PUBLIC"],
    )
    for path in [
        "tests/fixtures/alerts_list.json",
        "tests/fixtures/hosts_list.json",
        "vendor.sha256",
    ]
]
