load("//:buildrules.bzl", "cargo_package")

# What this package reads beyond src/, tests/ and build.rs, which a Buck2 action sees only when
# declared. The example hook binary lives under tests/bin; tests read the docs they are held to.
cargo_package(
    path = ".",
    extra_srcs = [
        "tests/bin",
        "//:MIGRATION.md",
        "//:docs/conformance.md",
    ],
)
