# Starts hostkeeper-channel-sync.service two minutes after boot and then ten minutes after each
# run ends, so two runs never overlap. A release published in CI reaches the channel within about
# ten minutes; run the service by hand (`systemctl start hostkeeper-channel-sync.service`) to
# sync at once.
[Unit]
Description=Sync the release channel every ten minutes

[Timer]
OnBootSec=2min
OnUnitInactiveSec=10min

[Install]
WantedBy=timers.target
