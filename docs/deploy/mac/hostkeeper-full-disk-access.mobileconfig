<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Grants hostkeeper's daemon Full Disk Access (PPPC), needed only if the daemon's report says
     `needs_full_disk_access` (docs/design/ssh-through-coordinator.md section 3).
     READ docs/deploy/mac/hostkeeper-full-disk-access.md BEFORE UPLOADING: the daemon in release
     0.1.333 carries only the linker's ad-hoc signature, with a signing identifier that changes at
     every build and no Team ID, so the code requirement below matches no shipped binary until the
     release signs the daemon with a Developer ID Application identity of Team U7RTX4XD3X and the
     identifier `dev.hostkeeper.hostkeeper`. The program is identified by that signing identifier
     and Team ID, not by a path, because the daemon execs a versioned binary that each update
     replaces. Needs a supervised Mac. -->
<plist version="1.0">
<dict>
  <key>PayloadType</key><string>Configuration</string>
  <key>PayloadVersion</key><integer>1</integer>
  <key>PayloadIdentifier</key><string>dev.hostkeeper.fda</string>
  <key>PayloadUUID</key><string>6B1D7C0E-5A52-4E0B-9B64-2F1C0A7E4D11</string>
  <key>PayloadDisplayName</key><string>hostkeeper Full Disk Access</string>
  <key>PayloadDescription</key><string>Lets the hostkeeper daemon turn on Remote Login.</string>
  <key>PayloadOrganization</key><string>hostkeeper</string>
  <key>PayloadRemovalDisallowed</key><false/>
  <key>PayloadScope</key><string>System</string>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key><string>com.apple.TCC.configuration-profile-policy</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadIdentifier</key><string>dev.hostkeeper.fda.pppc</string>
      <key>PayloadUUID</key><string>0C9A3E52-7D8B-4F6A-A1E3-93B5D2C8F047</string>
      <key>Services</key>
      <dict>
        <key>SystemPolicyAllFiles</key>
        <array>
          <dict>
            <key>Identifier</key><string>dev.hostkeeper.hostkeeper</string>
            <key>IdentifierType</key><string>bundleID</string>
            <key>CodeRequirement</key><string>identifier "dev.hostkeeper.hostkeeper" and anchor apple generic and certificate leaf[subject.OU] = "U7RTX4XD3X"</string>
            <key>Authorization</key><string>Allow</string>
            <key>StaticCode</key><false/>
            <key>Comment</key><string>hostkeeper daemon: turns on Remote Login</string>
          </dict>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
