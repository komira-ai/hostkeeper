#!/bin/sh
# The hostkeeper bootstrap pkg's postinstall: load the bootstrap's launchd job when launchd does
# not have it loaded, and leave it alone when it does (an installer run again must not boot a
# running job out). The job's RunAtLoad starts the bootstrap, which installs hostkeeper and exits.
/bin/launchctl print system/dev.hostkeeper.bootstrap >/dev/null 2>&1 && exit 0
exec /bin/launchctl bootstrap system /Library/LaunchDaemons/dev.hostkeeper.bootstrap.plist
